QUIZ_HTTP_PORT=8080
QUIZ_GRPC_PORT=9090

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=quizgo
POSTGRES_PASSWORD=replace_with_a_random_secret
POSTGRES_DB=quizgo
POSTGRES_SSLMODE=disable

# Docker Compose: all three secrets must be non-empty. JWT_SECRET and the
# gRPC service token must contain at least 32 bytes.
# Generate each value with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_secret
JWT_ISSUER=quizgo-auth
JWT_AUDIENCE=quizgo-crud
JWT_TTL=15m
QUIZ_GRPC_SERVICE_TOKEN=replace_with_a_different_random_secret

# Game service (HTTP/WebSocket realtime and Redis-backed sessions).
GAME_PORT=8081
GAME_REDIS_PASSWORD=
GAME_REDIS_DB=0
GAME_TTL=24h
# Room ownership. For multiple replicas, every process needs a unique instance
# ID and an internal URL identifying that exact process (not a shared LB name).
# The URL must be reachable by the other game-service replicas.
GAME_INSTANCE_ID=game-1
GAME_INTERNAL_URL=http://game:8081
GAME_ROOM_LEASE_TTL=15s
GAME_ROOM_LEASE_RENEW_INTERVAL=5s
GAME_ROOM_LEASE_SAFETY_MARGIN=1s
# Per-connection WebSocket safety limits.
GAME_WS_MAX_MESSAGE_BYTES=16384
GAME_WS_HANDSHAKE_TIMEOUT=10s
GAME_WS_COMMAND_TIMEOUT=5s
GAME_WS_WRITE_TIMEOUT=5s
GAME_WS_PING_INTERVAL=30s
GAME_WS_PONG_TIMEOUT=10s
GAME_WS_PLAYER_COMMAND_RATE=5
GAME_WS_PLAYER_COMMAND_BURST=10
GAME_WS_HOST_COMMAND_RATE=10
GAME_WS_HOST_COMMAND_BURST=20
GAME_WS_INVALID_MESSAGE_LIMIT=5

# Optional production mTLS. Either leave all four empty for local/private
# development or configure all four. The URI must match the realtime client
# certificate URI SAN exactly.
QUIZ_GRPC_TLS_CERT_FILE=
QUIZ_GRPC_TLS_KEY_FILE=
QUIZ_GRPC_TLS_CLIENT_CA_FILE=
QUIZ_GRPC_ALLOWED_CLIENT_URI=
# Client side of the same mTLS connection. Configure all three file paths or
# leave them empty for local/private development.
GAME_QUIZ_GRPC_CA_FILE=
GAME_QUIZ_GRPC_CERT_FILE=
GAME_QUIZ_GRPC_KEY_FILE=
GAME_QUIZ_GRPC_SERVER_NAME=
FRONTEND_PORT=3000
# Public hostname only, without https:// or a trailing slash.
DOMAIN=quiz.example.com

# Docker container log rotation (json-file driver).
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3

# S3: existing private bucket. Empty S3_BUCKET disables image uploads.
S3_BUCKET=
S3_REGION=us-east-1
# Leave endpoints empty for AWS. For S3-compatible providers use an HTTP(S) origin.
S3_ENDPOINT=
# Optional browser-accessible endpoint for signing (e.g. http://localhost:9000).
S3_BROWSER_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_URL_TTL=1h
# Backend only; never use VITE_* for credentials. IAM roles also work.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
