QUIZ_HTTP_PORT=8080

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=quizgo
POSTGRES_PASSWORD=replace_with_a_random_secret
POSTGRES_DB=quizgo
POSTGRES_SSLMODE=disable

# Docker Compose: POSTGRES_PASSWORD and JWT_SECRET must be non-empty.
# Generate each value with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_secret
FRONTEND_PORT=3000
# Public hostname only, without https:// or a trailing slash.
DOMAIN=quiz.example.com

# S3: existing private bucket. Empty S3_BUCKET disables image uploads.
S3_BUCKET=
S3_REGION=us-east-1
# Leave endpoints empty for AWS. For S3-compatible providers use an HTTP(S) origin.
S3_ENDPOINT=
# Optional browser-accessible endpoint for signing (e.g. http://localhost:9000).
S3_BROWSER_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_URL_TTL=1h
# Backend only; never use VITE_* for credentials. IAM roles also work.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
